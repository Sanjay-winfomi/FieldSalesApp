# FieldTrack Backend — Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fieldtrack
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# JWT secret — use any long random string in production
JWT_SECRET=fieldtrack_jwt_secret_change_in_production_2026
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# Dealer check-out radius tolerance in metres (configurable per Stage 7)
CHECKIN_RADIUS_METERS=100
