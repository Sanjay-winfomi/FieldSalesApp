{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://fieldtrack-backend-py.onrender.com/api",
        "EXPO_PUBLIC_MEETING_BACKEND_URL": "https://meeting-recorder-app-backend.onrender.com"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://fieldtrack-backend-py.onrender.com/api",
        "EXPO_PUBLIC_MEETING_BACKEND_URL": "https://meeting-recorder-app-backend.onrender.com"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
