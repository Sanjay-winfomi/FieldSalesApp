# FieldTrack Mobile — Environment Variables
# Copy this file to .env and fill in your values.
# EXPO_PUBLIC_-prefixed vars are inlined into the JS bundle at build time by
# Expo (SDK 49+) — no extra config needed, just restart `expo start` after
# changing this file.

# Base URL of the backend API, including the /api suffix.
# - Local dev on a physical device: use this machine's LAN IP (find it via
#   `ipconfig` / Get-NetIPAddress), e.g. http://192.168.0.57:3001/api
# - Android emulator: http://10.0.2.2:3001/api
# - Production: your real https:// backend URL — plain http:// sends login
#   credentials and tokens unencrypted and must never be used in production.
EXPO_PUBLIC_API_URL=http://192.168.0.57:3001/api

# Google Maps SDK keys for react-native-maps (Dealer Navigation's in-app map
# preview). Unlike the API URL above, these are NOT inlined into the JS
# bundle — they're read by app.config.js at `expo prebuild`/build time and
# baked into the native AndroidManifest.xml / Info.plist. Get one Maps SDK
# for Android key and one Maps SDK for iOS key from the Google Cloud Console
# (restrict each to its platform). For EAS Build, set these in the relevant
# eas.json build profile's `env` block (or as EAS secrets) instead of relying
# on this file, since EAS builds run on a remote machine.
EXPO_PUBLIC_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_MAPS_IOS_API_KEY=
