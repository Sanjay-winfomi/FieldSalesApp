# FieldTrack Mobile — Environment Variables
# Copy this file to .env and fill in your values.
# EXPO_PUBLIC_-prefixed vars are inlined into the JS bundle at build time by
# Expo (SDK 49+) — no extra config needed, just restart `expo start` after
# changing this file.

# Base URL of the backend API, including the /api suffix.
# - Local dev on a physical device: use this machine's LAN IP (find it via
#   `ipconfig` / Get-NetIPAddress), e.g. http://192.168.0.57:3001/api
# - Android emulator: http://10.0.2.2:3001/api
# - Production: your real https:// backend URL — plain http:// sends login
#   credentials and tokens unencrypted and must never be used in production.
EXPO_PUBLIC_API_URL=http://192.168.0.57:3001/api

# Base URL for the Meetings tab (SAS upload tokens, start transcription,
# fetch recordings/folders/status) — now served by the SAME backend as
# EXPO_PUBLIC_API_URL above (app/routers/meeting_recorder.py), just without
# the /api prefix, since its routes are mounted at root. Kept as a separate
# var (rather than deriving it from EXPO_PUBLIC_API_URL) in case these ever
# split across services again.
EXPO_PUBLIC_MEETING_BACKEND_URL=https://fieldtrack-backend-py.onrender.com
