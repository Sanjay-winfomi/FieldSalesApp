{
  "expo": {
    "name": "Winfomi",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.winfomi.fieldtrack",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.winfomi.fieldtrack",
      "adaptiveIcon": {
        "backgroundColor": "#FBFBFB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Winfomi uses your location to verify dealer logins/logouts and record attendance accurately. It is only read at the moment of login, logout, and periodic in-visit verification.",
          "locationAlwaysAndWhenInUsePermission": "Winfomi checks whether you're still within the dealer's premises during an open visit, including while the app is in the background — this only runs between logging in and logging out of a dealer.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#1B7F5A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5FBF6",
          "image": "./assets/brand/winfomi-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4380602a-3a21-4dd8-9e40-ec200b572e9f"
      }
    },
    "owner": "sanjay_winfomi"
  }
}
