# FieldTrack Web (manager dashboard) — Environment Variables
# Copy this file to .env and fill in your values.
# NEXT_PUBLIC_-prefixed vars are inlined into the JS bundle at build time by
# Next.js — restart `next dev`/rebuild after changing this file.

# Base URL of the backend API, including the /api suffix.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Google Cloud project needs Maps JavaScript API enabled, billing on.
# Restrict this key by HTTP referrer (your dashboard's domain) in Google Cloud
# Console — it's meant to be embedded in the browser bundle, that's normal for
# the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
