# FieldTrack Backend (Python/FastAPI port) — Environment Variables
# Copy this file to .env and fill in your values.
# Mirrors backend/.env.example exactly (same names/defaults) so render.yaml
# and other deploy config barely needs to change during cutover.

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fieldtrack
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
# Set to true for managed Postgres providers that require SSL (Render, Heroku, RDS, etc.)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# JWT secret — use any long random string in production
# MUST be byte-identical to the Node backend's JWT_SECRET during a rolling
# cutover, so tokens issued by one backend verify against the other.
JWT_SECRET=fieldtrack_jwt_secret_change_in_production_2026
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development
# Number of reverse-proxy hops to trust for X-Forwarded-* headers in production
# (needed for correct rate limiting / client IP behind Nginx, Render, Heroku, etc.)
TRUST_PROXY_HOPS=1
# Comma-separated list of allowed origins — required when NODE_ENV=production
# ALLOWED_ORIGINS=https://app.example.com

# Dealer logout radius tolerance in metres — system-wide fallback used only
# for dealers created before the per-dealer dealers.radius_meters column existed
LOGIN_RADIUS_METERS=200
# Max acceptable GPS accuracy (metres) for dealer login/logout; worse fixes are rejected
GPS_ACCURACY_THRESHOLD_METERS=30
# Max distance (metres) between login and logout GPS to still count as "same location"
LOGIN_MATCH_TOLERANCE_METERS=20

# Hour (0-23, IST) at which each rep's day resets — day/dealer login and
# logout become available again fresh at this time, not at midnight.
DAY_BOUNDARY_HOUR=5

# Google Cloud project needs Geocoding API + Places API + Routes API enabled, billing on.
# Server-side only — never expose this one to a client bundle.
GOOGLE_MAPS_API_KEY=

# Logging (present in Node backend's logger.js but was missing from its own
# .env.example — added here since it's a real, read env var; see NOTES.md)
LOG_DIR=logs
LOG_LEVEL=debug
